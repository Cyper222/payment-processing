# Development only. Replace all three secrets before exposing the service.
# Alphanumeric/hex credentials avoid escaping in the generated connection URLs.
API_KEY=replace-with-a-random-api-key-at-least-32-characters
POSTGRES_USER=payments
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password

API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
WEBHOOK_DEMO_PORT=8081

# An empty list permits only public destinations. Explicitly allow private
# destinations only for controlled integrations, e.g. ["webhook-receiver"].
WEBHOOK_ALLOWED_HOSTS=[]
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT=10
OUTBOX_POLL_INTERVAL=0.5
PUBLISH_TIMEOUT=5
LOG_LEVEL=INFO
